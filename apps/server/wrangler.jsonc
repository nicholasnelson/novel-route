{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "novel-route-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Served at api.novelroute.app (Cloudflare creates the DNS record and certificate) and on workers.dev.
  "routes": [{ "pattern": "api.novelroute.app", "custom_domain": true }],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novel-route",
      "database_id": "cbfd1de8-5ad4-4cae-b0ee-353e814e4160",
      "migrations_dir": "migrations"
    }
  ],
  // Per-client request limit (see docs/server.md "Abuse protection").
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "MAP_STYLE_URL": "mapbox://styles/mapbox/standard",
    "MIN_APP_VERSION": "",
    "MESSAGE": ""
  }
}
