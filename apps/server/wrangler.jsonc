{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "novel-route-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Served at api.novelroute.app (Cloudflare creates the DNS record and certificate) and on workers.dev.
  "routes": [{ "pattern": "api.novelroute.app", "custom_domain": true }],
  "workers_dev": true,
  // Seed areas: keeps the major cities covered, up to 3 Street Library calls per run (src/seeds.ts).
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novel-route",
      "database_id": "cbfd1de8-5ad4-4cae-b0ee-353e814e4160",
      "migrations_dir": "migrations"
    }
  ],
  // Per-client request limit (see docs/server.md "Abuse protection"). One request per tile, so
  // a zoomed-out view with retries can need a few dozen a minute.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    "MAP_STYLE_URL": "mapbox://styles/mapbox/standard",
    "MIN_APP_VERSION": "",
    "MESSAGE": ""
  }
}
