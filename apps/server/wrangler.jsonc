{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "novel-route-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novel-route",
      // Replace with the id printed by `npx wrangler d1 create novel-route`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Per-client request limit (see docs/server.md "Abuse protection").
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "MAP_STYLE_URL": "mapbox://styles/mapbox/standard",
    "MIN_APP_VERSION": "",
    "MESSAGE": ""
  }
}
