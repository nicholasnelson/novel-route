{
  "expo": {
    "name": "Novel Route",
    "slug": "novel-route",
    "scheme": "novelroute",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.novelroute"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "package": "app.novelroute"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show your location on the map and find nearby street libraries."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 240
        }
      ],
      "expo-sqlite",
      "@rnmapbox/maps",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native",
        {
          "url": "https://de.sentry.io/",
          "organization": "nelson-9e",
          "project": "novel-route-mobile"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b726aad7-00bc-4322-a18f-fbd379aa6aae"
      }
    },
    "owner": "ausshb"
  }
}
